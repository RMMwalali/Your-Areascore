# Database
DATABASE_URL=postgresql://user:pass@host:5432/areascore
POSTGIS_ENABLED=true

# Redis (optional)
REDIS_URL=redis://:pass@host:6379

# Geocoding provider
GEOCODER_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GOOGLE_GEOCODING_API_KEY=

# Overpass
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT="AreaScore/1.0 (contact: your-email@example.com)"
OVERPASS_TIMEOUT_SECONDS=25

# Premium POI enrichment (optional)
POI_ENRICH_PROVIDER=none
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=

ENRICH_ENABLED=true
ENRICH_ALLOWED_BBOXES=[{"name":"NairobiMetro","minLat":-1.6,"minLng":36.6,"maxLat":-1.1,"maxLng":37.2}]

# Auth (admin)
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
ADMIN_API_KEY=areascore-admin-key

# Storage for images
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App settings
APP_NAME=AreaScore
DEFAULT_COUNTRY=KE
CACHE_TTL_SECONDS=86400